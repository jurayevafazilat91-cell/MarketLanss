# Optional local JSON store path (relative to the project root).
LOCAL_STORE_PATH=data/store.json

# Shared password for every page and the data API (HTTP Basic Auth, any user name).
# Optional locally; required on Vercel, where the app answers 503 until it is set.
APP_PASSWORD=

# Optional Neon Postgres connection string (free plan: neon.tech). When set, it is used instead of the local JSON file.
# Keep the real value in .env.local; never commit it.
DATABASE_URL=

# Optional server-side Gemini API key for the AI chat and stock advice (free key: aistudio.google.com).
# Keep the real key in .env.local; never use a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=
